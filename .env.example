# Copiar a .env en la raiz. Nunca subir el archivo .env.
HOST=127.0.0.1
PORT=8080
APP_MODE=live
# Si se deja fuera, se usa data/leads.sqlite3 en la raiz del repositorio.
# DB_PATH=data/leads.sqlite3

# Base SIN /v1/pacientes. Se anexa /v1/pacientes internamente.
PATIENTS_API_BASE_URL=https://tu-api.example/pacientes
PATIENTS_API_TOKEN=
PATIENTS_MIN_INTERVAL=2.1
DEFAULT_PHONE_REGION=EC

# Base que incluye /v1 cuando el proveedor lo requiere; se anexa /chat/completions.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# json_schema para Structured Outputs; json_object para proveedores que solo admiten JSON.
# Ambos modos se validan localmente con el MISMO esquema.
LLM_RESPONSE_FORMAT=json_schema

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Solo un enlace real, verificado. Si falta, queda una solicitud sin cita confirmada.
AGENDA_URL=
# Opcional en localhost; obligatorio para escuchar en 0.0.0.0.
# El evaluador necesita este Bearer si usa el endpoint de consulta remoto.
QUERY_TOKEN=
WORKERS=3
HTTP_TIMEOUT=20
LEASE_SECONDS=45
MAX_ATTEMPTS=4
RETRY_BASE_SECONDS=5
STALE_SECONDS=120
# 0 desactiva aviso por silencio; ajustar con horario/campanas antes de activar.
SILENCE_SECONDS=0
